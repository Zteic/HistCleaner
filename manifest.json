{
  "manifest_version": 3,
  "name": "History Cleaner Keyword",
  "short_name": "HistCleaner",
  "version": "1.0.0",
  "description": "Cari dan hapus history, download, dan cookie berdasarkan kata kunci dengan mode auto-delete.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["history", "storage", "tabs", "alarms", "notifications", "downloads", "cookies"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "History Cleaner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}